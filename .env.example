# 数据采集使用。不要在 Vite 前端环境中使用该变量。
# 本地建议使用能读取公开仓库的只读或细粒度 Token。
GITHUB_TOKEN=

# 可选：覆盖数据目录；默认本地写入 public/data，GitHub Actions 使用 data-store。
# DATA_DIR=public/data

# 可选：构建时从该目录读取 latest.json / history.json / status.json。
# DATA_SOURCE=data-store

# 可选：GitHub Pages 子路径，例如 /dsh-plugin-health-monitor/。
# VITE_BASE=/

# 可选：npm run data:pull 的仓库，默认 albert404s/dsh-plugin-health-monitor。
# DATA_REPO_SLUG=albert404s/dsh-plugin-health-monitor
# DATA_BRANCH=data
